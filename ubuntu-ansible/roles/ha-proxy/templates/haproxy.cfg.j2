frontend kubernetes
    bind {{ ansible_default_ipv4.address }}:6443
    option tcplog
    mode tcp
    default_backend kubernetes-master-nodes

backend kubernetes-master-nodes
    mode tcp
    balance roundrobin
    option tcp-check
{% for i in groups['masters'] %}
    server {{ hostvars[i].inventory_hostname }} {{ hostvars[i].ansible_default_ipv4.address }}:6443 check fall 3 rise 2
{% endfor %}
