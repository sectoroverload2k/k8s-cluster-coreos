---
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: podsubnet-pool
  namespace: metallb-system
spec:
  protocol: layer2
  autoAssign: true
  addresses:
    - {{ podsubnet }}
---
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: servicesubnet-pool
  namespace: metallb-system
spec:
  autoAssign: true
  avoidBuggyIPs: true
  addresses:
    - {{ servicesubnet }}

